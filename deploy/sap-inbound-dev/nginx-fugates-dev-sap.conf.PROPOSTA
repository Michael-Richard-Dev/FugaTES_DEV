# ============================================================================
# PROPOSTA — ingresso SAP/CPI dedicado ao receptor DEV.  NAO PUBLICAR.
#
# Arquivo de PROPOSTA (sufixo .PROPOSTA): nao deve ser copiado para
# /etc/nginx/sites-available nem ligado em sites-enabled sem autorizacao da Hera.
#
# PRESERVACAO: nao altera uma linha de fugates-hml-http.conf. E um server block
# SEPARADO, em porta separada, com backend separado. A rota HML em
# 192.168.17.40:80 -> 127.0.0.1:8080 continua exatamente como esta.
#
# Pendencias marcadas <<PENDENTE...>> deixam a configuracao invalida de proposito.
# ============================================================================

server {
    # TLS efetivo no ponto de ingresso (exigencia da Etapa D).
    # Porta distinta da HML (80) e das portas privadas 18761/18762/18763.
    listen 192.168.17.40:<<PENDENTE_PORTA_TLS_DEV_APROVADA_HERA>> ssl;
    http2 on;

    server_name <<PENDENTE_NOME_DNS_DEV_APROVADO_HERA>>;

    ssl_certificate     <<PENDENTE_CAMINHO_CERTIFICADO_DEV>>;
    ssl_certificate_key <<PENDENTE_CAMINHO_CHAVE_PRIVADA_DEV>>;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Nao persistir material de requisicao neste ingresso, como na rota HML.
    access_log off;

    location = /api/v1/integracoes/sap/contratos {
        # ---- Origem SAP/CPI identificada e autorizada --------------------
        # Mesma lista ja instalada e comprovada na rota HML (R162). Reutilizada,
        # nao inventada. Confirmar com a Hera se o DEV recebe das MESMAS origens.
        allow 10.200.3.77;
        allow 10.200.2.17;
        allow 192.168.3.173;
        allow 10.30.3.2;
        allow 192.168.254.101/32;
        deny all;

        # Somente POST faz sentido para admissao contratual.
        limit_except POST { deny all; }

        # ---- Backend DEV, separado do HML 8080 ---------------------------
        proxy_pass http://127.0.0.1:<<PENDENTE_PORTA_LOOPBACK_RECEPTOR_DEV>>;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nao confiar no X-Forwarded-For enviado pelo cliente.
        proxy_set_header X-Forwarded-For $remote_addr;

        # ---- Diferenca essencial frente a rota HML -----------------------
        # A rota HML envia "http" e REMOVE o Authorization. O receptor exige
        # SecurityMode=LoopbackBasicHttps, que recusa com 403 sem "https" e com
        # 401 sem Basic. Aqui o TLS e real e o Authorization e PRESERVADO.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;

        # Admissao unitaria: corpo pequeno e sem buffering em disco.
        client_max_body_size 256k;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Nada mais e exposto por este ingresso.
    location / { return 404; }
}
