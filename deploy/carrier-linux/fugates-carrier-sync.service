[Unit]
Description=FugaTES Carrier HML - SAP to Guardian (preflight disabled)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=fugates-carrier
Group=fugates-carrier
WorkingDirectory=/opt/fugates/carrier-sync
ExecStart=/opt/fugates/carrier-sync/FugaTES.HostIntegracao
Environment=DOTNET_ENVIRONMENT=Production
Environment=HostIntegracao__Mode=CarrierSync
Environment=Carrier__Environment=HML
Environment=Carrier__LinuxProfile=/etc/fugates/carrier-hml.json
Environment=FUGATES_CARRIER_SYNC_ENABLED=false
Environment=CARRIER_WORKER_ENABLED=false
Environment=FUGATES_INTEGRATION_WORKER_ENABLED=false
Environment=INC005_WORKER_ENABLED=false
Environment=Logging__LogLevel__Default=Warning
Environment=Logging__LogLevel__FugaTES.HostIntegracao=Information
LoadCredentialEncrypted=carrier-hml-postgres-password:/etc/credstore.encrypted/fugates-carrier-hml-postgres-password.cred
LoadCredentialEncrypted=carrier-hml-guardian-email:/etc/credstore.encrypted/fugates-carrier-hml-guardian-email.cred
LoadCredentialEncrypted=carrier-hml-guardian-password:/etc/credstore.encrypted/fugates-carrier-hml-guardian-password.cred
LoadCredentialEncrypted=carrier-hml-guardian-signature:/etc/credstore.encrypted/fugates-carrier-hml-guardian-signature.cred
LoadCredentialEncrypted=carrier-hml-sap-user:/etc/credstore.encrypted/fugates-carrier-hml-sap-user.cred
LoadCredentialEncrypted=carrier-hml-sap-password:/etc/credstore.encrypted/fugates-carrier-hml-sap-password.cred
Restart=on-failure
RestartSec=10s
TimeoutStartSec=75s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fugates-carrier-sync

[Install]
WantedBy=multi-user.target