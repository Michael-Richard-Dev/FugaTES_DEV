+using FugaTES.Persistencia.Transportadoras;
+using Microsoft.Extensions.Configuration;
+using Npgsql;
+namespace FugaTES.WinForms.Transportadoras.MasterdataR3;
+
+// R150C: composicao REAL do SingleCreate com o datasource MasterData HML dedicado.
+// Especificacao R135D §4.1/§4.2: o journal recebe um NpgsqlDataSource PROPRIO, nao enlistado,
+// criado e possuido aqui. Nunca reutiliza o datasource ACM legado (DesktopRuntime.CreateReadSource
+// / CreateCarrierStore), e nao ha fallback para o pool compartilhado se o dedicado falhar.
+//
+// Nao habilita escrita: SingleCreateDesktopBindingR41 continua exigindo Carrier:SingleCreate:Enabled,
+// perfil HML, identidade, assinatura e journal fisico.
+public sealed record MasterdataHmlCompositionResultR150C(
+    SingleCreateBindingR41? Binding, NpgsqlDataSource? Source, string Code) : IAsyncDisposable
+{
+    public bool Ready => Binding is { Ready: true } && Source is not null;
+    public async ValueTask DisposeAsync() { if (Source is not null) await Source.DisposeAsync(); }
+    public override string ToString() => Code;
+}
+
+public static class MasterdataHmlSingleCreateCompositionR150C
+{
+    public const string ChaveConexao = "Carrier:MasterdataHml:ConnectionString";
+
+    // Guarda de identidade FISICA, executada depois de abrir a conexao (item 4 do gate).
+    // Nao basta a connection string prometer 5434: o servidor precisa confirmar quem e.
+    public const string IdentidadeSql = """
+        select current_database()
+             , coalesce(current_setting('cluster_name',true),'')
+             , current_setting('port')::int
+             , current_user
+             , current_setting('server_version_num')::int
+             , pg_is_in_recovery()
+        """;
+
+    public static async Task<string?> VerificarIdentidadeFisicaAsync(
+        NpgsqlDataSource source, MasterdataHmlTargetR147B alvo, CancellationToken ct)
+    {
+        try
+        {
+            await using var command = source.CreateCommand(IdentidadeSql);
+            await using var reader = await command.ExecuteReaderAsync(ct).ConfigureAwait(false);
+            if (!await reader.ReadAsync(ct).ConfigureAwait(false)) return "MASTERDATA_HML_IDENTITY_UNREADABLE";
+            var database = reader.GetString(0);
+            var cluster = reader.GetString(1);
+            var porta = reader.GetInt32(2);
+            var usuario = reader.GetString(3);
+            var versao = reader.GetInt32(4);
+            var recovery = reader.GetBoolean(5);
+
+            if (!string.Equals(database, alvo.Database, StringComparison.Ordinal)) return "MASTERDATA_HML_PHYSICAL_DATABASE_MISMATCH";
+            if (cluster != "18/fugatesmdhml") return "MASTERDATA_HML_PHYSICAL_CLUSTER_MISMATCH";
+            // Porta REAL do servidor (5434), nao a do tunel local (15434).
+            if (porta != 5434) return "MASTERDATA_HML_PHYSICAL_PORT_MISMATCH";
+            if (!string.Equals(usuario, alvo.AppRole, StringComparison.Ordinal)) return "MASTERDATA_HML_PHYSICAL_ROLE_MISMATCH";
+            if (versao is < 180000 or > 189999) return "MASTERDATA_HML_PHYSICAL_VERSION_MISMATCH";
+            if (recovery) return "MASTERDATA_HML_SERVER_IN_RECOVERY";
+            return null;
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return "MASTERDATA_HML_CANCELLED"; }
+        catch { return "MASTERDATA_HML_IDENTITY_PROBE_FAILED"; }
+    }
+
+    // Caminho real: perfil -> datasource dedicado (Enlist=false) -> identidade fisica -> BindAsync.
+    public static async Task<MasterdataHmlCompositionResultR150C> ComporAsync(
+        IConfiguration config, PreparedSingleCreateR41 prepared,
+        FugaTES.Aplicacao.Transportadoras.IGuardianCarrierManualReadOnly reader,
+        FugaTES.HostIntegracao.SingleCreateGatewayFactoryR42 gatewayFactory,
+        Func<bool>? gate = null, TimeProvider? clock = null,
+        MasterdataHmlTargetR147B? alvo = null, CancellationToken ct = default)
+    {
+        ArgumentNullException.ThrowIfNull(config);
+        alvo ??= MasterdataHmlTargetR147B.Proposto;
+
+        var conexao = config[ChaveConexao];
+        if (string.IsNullOrWhiteSpace(conexao))
+            return new(null, null, "MASTERDATA_HML_CONNECTION_NOT_CONFIGURED");
+
+        // Rejeita 5432/5433 e identidade legada ANTES de abrir qualquer conexao.
+        NpgsqlDataSource source;
+        try { source = MasterdataHmlDataSourceR147B.Criar(conexao, alvo); }
+        catch (InvalidOperationException erro) { return new(null, null, erro.Message); }
+        catch { return new(null, null, "MASTERDATA_HML_DATASOURCE_FAILED"); }
+
+        try
+        {
+            if (await VerificarIdentidadeFisicaAsync(source, alvo, ct).ConfigureAwait(false) is { } divergencia)
+            {
+                await source.DisposeAsync();
+                return new(null, null, divergencia);
+            }
+
+            // Sem fallback: o binding recebe exclusivamente o datasource dedicado.
+            var binding = await SingleCreateDesktopBindingR41.BindAsync(
+                config, prepared, reader, gatewayFactory, source, gate, clock, ct).ConfigureAwait(false);
+            if (!binding.Ready) { await source.DisposeAsync(); return new(null, null, binding.Code); }
+            return new(binding, source, binding.Code);
+        }
+        catch
+        {
+            await source.DisposeAsync();
+            return new(null, null, "MASTERDATA_HML_COMPOSITION_FAILED");
+        }
+    }
+}
