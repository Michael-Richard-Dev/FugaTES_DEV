+    internal sealed class MemorySource : DbDataSource
+    {
+        internal sealed class EventLog:ConcurrentQueue<string>{public void Add(string e)=>Enqueue(e);public int IndexOf(string e)=>Array.IndexOf(ToArray(),e);}
+        internal readonly EventLog Events=new();
+        readonly HashSet<string> reserved=[];readonly object sync=new();
+        internal string? Failure;internal bool Refuse,HoldCommit,CommandWasEnlisted;
+        internal Action? AfterCommit;
+        internal int Inserts,Commits;
+        internal TaskCompletionSource CommitEntered=new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal TaskCompletionSource ReleaseCommit=new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public override string ConnectionString=>"SYNTHETIC_MEMORY_ONLY";
+        protected override DbConnection CreateDbConnection()=>new Connection(this);
+        internal sealed class Connection(MemorySource db):DbConnection
+        {
+            ConnectionState state;internal string? ReservedKey;
+            [AllowNull] public override string ConnectionString{get;set;}="";
+            public override string Database=>"SYNTHETIC";public override string DataSource=>"MEMORY";public override string ServerVersion=>"OFFLINE";public override ConnectionState State=>state;
+            public override void ChangeDatabase(string n)=>throw new NotSupportedException();
+            public override void Open(){state=ConnectionState.Open;db.Events.Add("OPEN");}
+            public override Task OpenAsync(CancellationToken ct){ct.ThrowIfCancellationRequested();Open();return Task.CompletedTask;}
+            public override void Close()=>state=ConnectionState.Closed;
+            protected override DbTransaction BeginDbTransaction(IsolationLevel level){db.Events.Add("BEGIN");return new Transaction(db,this,level);}
+            protected override DbCommand CreateDbCommand()=>new Command(db,this);
+            protected override void Dispose(bool disposing){db.Events.Add("DISPOSE_CONNECTION");Close();base.Dispose(disposing);}
+        }
+        sealed class Transaction(MemorySource db,Connection c,IsolationLevel level):DbTransaction
+        {
+            bool committed;
+            public override IsolationLevel IsolationLevel=>level;protected override DbConnection DbConnection=>c;
+            public override void Commit()=>CommitAsync().GetAwaiter().GetResult();
+            public override async Task CommitAsync(CancellationToken ct=default)
+            {
+                db.CommitEntered.TrySetResult();if(db.HoldCommit)await db.ReleaseCommit.Task.WaitAsync(ct);
+                if(db.Failure=="COMMIT_EXCEPTION")throw new InvalidOperationException("SYNTHETIC_COMMIT_FAILURE");
+                if(db.Failure=="COMMIT_INDETERMINATE"){committed=true;throw new TimeoutException("SYNTHETIC_ACK_LOST");}
+                if(db.Failure=="COMMIT_CANCELLED")throw new OperationCanceledException();
+                committed=true;Interlocked.Increment(ref db.Commits);db.Events.Add("COMMIT_CONFIRMED");db.AfterCommit?.Invoke();
+            }
+            public override void Rollback(){db.Events.Add("ROLLBACK");if(!committed&&c.ReservedKey is {} key){lock(db.sync)db.reserved.Remove(key);c.ReservedKey=null;}}
+            protected override void Dispose(bool disposing){if(!committed)Rollback();base.Dispose(disposing);}
+        }
+        sealed class Command(MemorySource db,Connection c):DbCommand
