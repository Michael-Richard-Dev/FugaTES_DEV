<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <FugaTESAcmMonitorR165M>true</FugaTESAcmMonitorR165M>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FugaTESDemoR50)' == 'true'">
    <DefineConstants>$(DefineConstants);FUGATES_SAFE_DEMO_R50</DefineConstants>
    <AssemblyName>FugaTES</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FugaTESAcmMonitorR165M)' == 'true'">
    <DefineConstants>$(DefineConstants);FUGATES_ACM_MONITOR_R165M</DefineConstants>
    <AssemblyName>FugaTES.AcmMonitor.R165R</AssemblyName>
    <Version>1.0.165.18</Version>
  </PropertyGroup>
  <Target Name="RejectMixedMonitorModes" BeforeTargets="CoreCompile" Condition="'$(FugaTESAcmMonitorR165M)' == 'true' and '$(FugaTESDemoR50)' == 'true'">
    <Error Text="R165M monitor cannot be combined with a business/demo startup." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\FugaTES.Aplicacao\FugaTES.Aplicacao.csproj" />
    <ProjectReference Include="..\FugaTES.Persistencia\FugaTES.Persistencia.csproj" />
    <ProjectReference Include="..\FugaTES.Infraestrutura\FugaTES.Infraestrutura.csproj" />
    <ProjectReference Include="..\FugaTES.HostIntegracao\FugaTES.HostIntegracao.csproj" />
    <Compile Remove="Runtime\DesktopStartupException.cs" />
    <None Update="AcmMonitor.R165M.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyName>FugaTES</AssemblyName>
    <Version>1.2.11</Version>
    <FileVersion>1.2.11.0</FileVersion>
    <InformationalVersion>1.2.11+toledo.sap.continuous.20261031</InformationalVersion>
  </PropertyGroup>
</Project>
